# Base de datos (SQLite en desarrollo; en producción use PostgreSQL y cambie el provider en prisma/schema.prisma)
DATABASE_URL="file:./dev.db"

# Secreto para firmar sesiones del panel (mínimo 32 caracteres)
AUTH_SECRET="cambie-esto-por-un-secreto-largo-y-aleatorio"

# Agente IA (Claude). Sin clave, el agente usa respuestas de respaldo.
ANTHROPIC_API_KEY=""

# WhatsApp Business Cloud API (Meta). Sin token, los mensajes se simulan y quedan en el log.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""      # token que usted define al registrar el webhook en Meta
WHATSAPP_APP_SECRET=""        # valida la firma X-Hub-Signature-256 de los webhooks
WHATSAPP_TEMPLATE_NAME=""     # plantilla aprobada para el primer contacto ({{1}} nombre, {{2}} ticket)
WHATSAPP_TEMPLATE_LANG="es"
