# Caddy obtiene y renueva el certificado HTTPS (Let's Encrypt) para $DOMAIN automáticamente.
# Para servir también www, use DOMAIN="produccionesgallardo.com, www.produccionesgallardo.com".
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
	}
	reverse_proxy app:3000
}
